# ============================================================
# 四轮控制指令 (WheelCommands)
# ============================================================
# 由 lunar_car_ctrl 节点发布: 实际发送给车端的四轮指令
#
# 坐标系: 左手坐标系 (LH, 与车端一致) — 经右手系运动学计算后
#          转换得到: 轮速不变, 转角取反
# 车轮编号: FL=前左(0), FR=前右(1), RL=后左(2), RR=后右(3)
# ============================================================

std_msgs/Header header

# ---- 四轮轮速 (rad/s, 左手系) ----
float64[4] wheel_speed       # FL / FR / RL / RR 轮速

# ---- 四轮转向角 (rad, 左手系) ----
float64[4] steer_angle       # FL / FR / RL / RR 转角
