<?xml version="1.0"?>
<package format="3">
  <name>lunar_incremental_controller_demo</name>
  <version>0.1.0</version>
  <description>Isolated command-driven SE2 plant and evidence runner for incremental navigation.</description>
  <maintainer email="kai@example.com">Kai</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>grid_map_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>lunar_planning_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>lunar_incremental_navigation_ros</exec_depend>
