<?xml version="1.0"?>
<package format="3">
  <name>lunar_planner_training_bridge</name>
  <version>0.1.0</version>
  <description>In-process Python bridge to the lunar C++ v3 planner.</description>
  <maintainer email="maintainers@example.invalid">Lunar Navigation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>lunar_planner_core</build_depend>
  <build_depend>pybind11_vendor</build_depend>

  <depend>urdf</depend>

  <exec_depend>lunar_planner_core</exec_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
