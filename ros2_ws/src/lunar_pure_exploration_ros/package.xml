<?xml version="1.0"?>
<package format="3">
  <name>lunar_pure_exploration_ros</name>
  <version>0.1.0</version>
  <description>ROS adapters for pure-frontier exploration.</description>
  <maintainer email="maintainers@example.invalid">Lunar Navigation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>lunar_planning_msgs</depend>
  <depend>lunar_pure_exploration_core</depend>
  <depend>lunar_pure_exploration_msgs</depend>
  <depend>lunar_pure_planner_core</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lunar_pure_planner_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>lunar_pure_planner_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
