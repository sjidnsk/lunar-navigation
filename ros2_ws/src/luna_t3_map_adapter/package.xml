<?xml version="1.0"?>
<package format="3">
  <name>luna_t3_map_adapter</name>
  <version>0.1.0</version>
  <description>Task3 large-map adapter for canonical lunar planning inputs.</description>
  <maintainer email="maintainers@example.invalid">Lunar Navigation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>lunar_planner_core</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>grid_map_msgs</exec_depend>
  <exec_depend>lunar_navigation_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
