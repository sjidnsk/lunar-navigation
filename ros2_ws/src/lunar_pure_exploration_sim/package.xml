<?xml version="1.0"?>
<package format="3">
  <name>lunar_pure_exploration_sim</name>
  <version>0.1.0</version>
  <description>Deterministic lunar truth scene for isolated exploration simulation.</description>
  <maintainer email="maintainers@example.invalid">Lunar Navigation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>grid_map_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
