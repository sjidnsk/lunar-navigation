<?xml version="1.0"?>
<package format="3">
  <name>lunar_unreal_tcp_bridge</name>
  <version>0.1.0</version>
  <description>Fail-closed Unreal TCP v1 codec and ROS bridge for lunar navigation.</description>
  <maintainer email="maintainers@example.invalid">Lunar Navigation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>grid_map_msgs</depend>
  <depend>lunar_navigation_msgs</depend>
  <depend>lunar_planning_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nlohmann-json3-dev</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
