<?xml version="1.0"?>
<package format="3">
  <name>luna_wheeled_controller</name>
  <version>0.1.0</version>
  <description>Safe WHEELED reference coordination and trajectory tracking.</description>
  <maintainer email="maintainers@example.invalid">Lunar Navigation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>lunar_navigation_msgs</exec_depend>
  <exec_depend>lunar_planning_msgs</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
