<?xml version="1.0"?>
<package format="3">
  <name>lunar_pure_planner_ros</name>
  <version>0.1.0</version>
  <description>Isolated ROS integration surface for the pure lunar planner.</description>
  <maintainer email="maintainers@example.invalid">Lunar Navigation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>lunar_pure_planner_core</depend>
  <depend>lunar_planning_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>grid_map_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>action_msgs</test_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend condition="$ROS_DISTRO == 'jazzy'">grid_map_rviz_plugin</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
